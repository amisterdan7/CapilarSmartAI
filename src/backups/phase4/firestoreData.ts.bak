// ==========================================
// OPERAÇÕES: CONFIGURAÇÕES DA PROFISSIONAL
// ==========================================

export const fetchSettingsFromFirestore = async (
  professionalId: string
): Promise<SalonSettings | null> => {
  if (!isFirebaseConfigured() || !db) return null;
  if (!professionalId) throw new Error('fetchSettingsFromFirestore: professionalId é obrigatório.');

  try {
    const ref = doc(db, 'settings', professionalId);
    const snap = await getDoc(ref);
    if (snap.exists()) {
      const data = snap.data();
      return {
        salonName: data.salonName || '',
        professionalName: data.professionalName || '',
        phone: data.phone || '',
        instagram: data.instagram || '',
        enableSenacBadge: Boolean(data.enableSenacBadge),
        defaultPauseTime: typeof data.defaultPauseTime === 'number' ? data.defaultPauseTime : 25,
        customNotes: data.customNotes || '',
      };
    }
    return null;
  } catch (error) {
    throw handleFirestoreError(error, {
      operation: 'read',
      collection: 'settings',
      documentId: professionalId,
    });
  }
};

export const saveSettingsToFirestore = async (
  settings: SalonSettings,
  professionalId: string
): Promise<void> => {
  const dbInstance = requireDb();
  if (!professionalId) throw new Error('saveSettingsToFirestore: professionalId é obrigatório.');

  const payload = sanitizeSettingsForFirestore(settings, professionalId);
  try {
    const ref = doc(dbInstance, 'settings', professionalId);
    await setDoc(ref, payload, { merge: true });
  } catch (error) {
    throw handleFirestoreError(error, {
      operation: 'update',
      collection: 'settings',
      documentId: professionalId,
    });
  }
};

// ==========================================
// IMPORTAÇÃO CONTROLADA E EXPLÍCITA
// ==========================================

export interface LocalImportSummary {
  clientsCount: number;
  evaluationsCount: number;
  productsCount: number;
  settingsImported: boolean;
}

/**
 * Importa dados locais explicitamente para a conta da profissional autenticada.
 * Ordem estrita de execução:
 * 1. Salva Clientes primeiro (para que a regra Master-Gate clientBelongsToProfessional permita as avaliações).
 * 2. Salva Avaliações vinculadas aos clientes recém-gravados.
 * 3. Salva Produtos.
 * 4. Salva Configurações.
 */
export const importLocalDataToFirestore = async (
  professionalId: string,
  localClients: ClientData[],
  localEvaluations: FullEvaluationRecord[],
  localProducts: SalonProduct[],
  localSettings: SalonSettings
): Promise<LocalImportSummary> => {
  if (!professionalId) throw new Error('importLocalDataToFirestore: professionalId é obrigatório.');

  let clientsCount = 0;
  let evaluationsCount = 0;
  let productsCount = 0;
  let settingsImported = false;

  // 1. Clientes
  for (const client of localClients) {
    await saveClientToFirestore(client, professionalId);
    clientsCount++;
  }

  // 2. Avaliações (apenas aquelas cujos clientes agora pertencem a esta profissional)
  for (const evaluation of localEvaluations) {
    await saveEvaluationToFirestore(evaluation, professionalId);
    evaluationsCount++;
  }

  // 3. Produtos
  for (const product of localProducts) {
    await saveProductToFirestore(product, professionalId);
    productsCount++;
  }

  // 4. Configurações
  if (localSettings) {
    await saveSettingsToFirestore(localSettings, professionalId);
    settingsImported = true;
  }

  return {
    clientsCount,
    evaluationsCount,
    productsCount,
    settingsImported,
  };
};
